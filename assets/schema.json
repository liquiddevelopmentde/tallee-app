          "color": {
            "type": "string"
          },
          "selectedGroups": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "selectedGames": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "displayCount": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "createdAt",
          "type",
          "scopes",
          "timeframe",
          "color",
          "displayCount"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "players",
    "games",
    "groups",
    "matches",
    "statistics"
  ]
}