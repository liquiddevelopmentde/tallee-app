{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer"
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "createdAt",
          "name",
          "description",
          "deleted"
        ]
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ruleset": {
            "type": "string",
            "enum": [
              "winner",
              "loser",
              "highestScore",
              "lowestScore",
              "lives",
              "placement"
            ]
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              "teal",
              "blue",
              "purple",
              "pink"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "createdAt",
          "name",
          "ruleset",
          "description",
          "color"
        ]
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "memberIds": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "createdAt",
          "description",
          "color",
          "memberIds"
        ]
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "gameId": {
            "type": "string"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "playerIds": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "roundNumber": {
                      "type": "number"
                    },
                    "score": {
                      "type": "number"
                    },
                    "change": {
                      "type": "number"
                    },
                    "timerStartedAt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "roundNumber",
                    "change"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "notes": {
            "type": "string"
          },
          "isTeamMatch": {
            "type": "boolean"
          },
          "teams": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "red",
                    "orange",
                    "yellow",
                    "green",
                    "teal",
                    "blue",
                    "purple",
                    "pink"
                  ]
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "timerStartedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "memberIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "createdAt",
                "color",
                "memberIds"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "createdAt",
          "gameId",
          "playerIds",
          "notes",
          "isTeamMatch"
        ]
      }
    },
    "statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "allPlayers",
                "selectedGroups",
                "selectedGames"
              ]
            }
          },
          "timeframe": {
            "type": "string",
            "enum": [
              "last7Days",
              "last30Days",
              "last90Days",
              "last180Days",
              "lastYear",
              "custom",
              "allTime"
            ]
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": "string",
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              "teal",
              "blue",
              "purple",
              "pink"
            ]
          },
          "selectedGroups": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "selectedGames": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "displayCount": {
            "type": "number"
          },
          "isFavourite": {
            "type": "boolean"
          },
          "position": {
            "type": "number"
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "descending",
              "ascending"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "createdAt",
          "type",
          "scopes",
          "timeframe",
          "color",
          "displayCount",
          "isFavourite",
          "position",
          "sortDirection"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "players",
    "games",
    "groups",
    "matches",
    "statistics"
  ]
}