{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "gameId": {
      "type": "string"
    },
    "groupId": {
      "type": [
        "string",
        "null"
      ]
    },
    "playerIds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "roundNumber": {
                "type": "number"
              },
              "score": {
                "type": "number"
              },
              "change": {
                "type": "number"
              }
            },
            "required": [
              "roundNumber",
              "score",
              "change"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "isTeamMatch": {
      "type": "boolean"
    },
    "teams": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "memberIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "createdAt",
          "color",
          "memberIds"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "createdAt",
    "gameId",
    "playerIds",
    "notes",
    "isTeamMatch",
    "scores"
  ]
}