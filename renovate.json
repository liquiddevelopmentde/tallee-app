{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "baseBranchPatterns": [
    "development"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "labels": [
    "Type/Dependencies"
  ],
  "enabledManagers": [
    "pub"
  ],
  "pub": {
    "enabled": true,
    "managerFilePatterns": [
      "/(^|/)pubspec\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "pub"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "pub"
      ],
      "matchDepNames": [
        "dart"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pub"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dart dependencies (minor)",
      "groupSlug": "dart-minor"
    },
    {
      "matchManagers": [
        "pub"
      ],
      "matchDepNames": [
        "build_runner",
        "drift",
        "drift_dev",
        "drift_flutter"
      ],
      "groupName": "codegen",
      "groupSlug": "codegen"
    }
  ]
}
